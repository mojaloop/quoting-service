    "axios": "1.20.0",
    "blipp": "4.0.2",
    "commander": "15.0.0",
    "event-stream": "4.0.1",
    "fast-safe-stringify": "2.1.1",
    "joi": "18.3.0",
    "json-rules-engine": "7.3.1",
