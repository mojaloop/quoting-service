{
  "name": "quoting-service",
  "private": true,
  "description": "Quoting Service hosted by a scheme",
  "license": "Apache-2.0",
  "version": "17.15.0",
  "author": "ModusBox",
  "contributors": [
    "Georgi Georgiev <georgi.georgiev@modusbox.com>",
    "Henk Kodde <henk.kodde@modusbox.com>",
    "James Bush <james.bush@modusbox.com>",
    "Miguel de Barros <miguel.debarros@modusbox.com>",
    "Rajiv Mothilal <rajiv.mothilal@modusbox.com>",
    "Sam Kummary <sam@modusbox.com>",
    "Shashikant Hirugade <shashikant.hirugade@modusbox.com>",
    "Steven Oderayi <steven.oderayi@modusbox.com>",
    "Vassilis Barzokas <vassilis.barzokas@modusbox.com>",
    "Juan Correa <juan.correa@modusbox.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/mojaloop/quoting-service.git"
  },
  "bugs": "http://github.com/mojaloop/quoting-service/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "jest-junit": {
    "outputDirectory": "./test/results",
    "outputName": "junit.xml"
  },
  "standard": {
    "env": [
      "jest"
    ]
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace '\\[mojaloop/#(\\d+)\\]\\(https://github.com/mojaloop/(.*)/issues/(\\d+)\\)' '[mojaloop/#$1](https://github.com/mojaloop/project/issues/$1)' CHANGELOG.md"
    }
  },
  "engines": {
    "node": ">=18.x"
  },
  "pre-commit": [
    "lint",
    "dep:check",
    "audit:check",
    "test:unit"
  ],
  "scripts": {
    "start": "npm run start:api",
    "start:api": "node src/index.js",
    "start:debug": "node --inspect=0.0.0.0 src/index.js",
    "start:handlers": "node src/handlers/index.js h --quotes --bulk_quotes --fx_quotes",
    "start:handlers:debug": "node --inspect=0.0.0.0 src/handlers/index.js h --quotes --bulk_quotes --fx_quotes",
    "watch:api": "npx nodemon src/index.js",
    "dev": "npm run docker:stop && docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build -d",
    "lint": "npx standard",
    "lint:fix": "npx standard --fix",
    "test": "npm run test:unit",
    "test:unit": "jest --runInBand --testMatch \"**/test/unit/**/*.test.js\"",
    "test:unit:dto": "jest --testMatch \"**/test/unit/lib/dto.test.js\"",
    "test:unit:pc": "jest --testMatch \"**/test/unit/lib/payloadCache.test.js\"",
    "test:xunit": "npm run test:junit",
    "test:coverage": "jest --coverage --coverageThreshold=\"{}\" --testMatch \"**/test/unit/**/*.test.js\"",
    "test:coverage-check": "jest --runInBand --forceExit --coverage --testMatch \"**/test/unit/**/*.test.js\"",
    "test:junit": "jest --runInBand --forceExit --reporters=default --reporters=jest-junit --testMatch \"**/test/unit/**/*.test.js\"",
    "test:int": "jest --runInBand --testMatch \"**/test/integration/**/*.test.js\"",
    "test:integration": "./test/integration/scripts/start.sh && npm run test:int",
    "test:functional": "true",
    "regenerate": "yo swaggerize:test --framework hapi --apiPath './src/interface/swagger.json'",
    "run": "docker run -p 3002:3002 --rm --link db:mysql quoting-service:local",
    "docker:build": "docker build --build-arg NODE_VERSION=\"$(cat .nvmrc)-alpine\" -t mojaloop/quoting-service:local -f ./Dockerfile .",
    "docker:up": ". ./scripts/env.sh && docker-compose up -d",
    "docker:stop": "docker-compose stop",
    "docker:rm": "docker-compose rm -f -v",
    "docker:down": "docker-compose down -v",
    "docker:clean": "docker-compose down --rmi local",
    "generate-docs": "npx jsdoc -c jsdoc.json",
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "dep:check": "npx ncu -e 2",
    "dep:update": "npx ncu -u",
    "release": "npx standard-version --no-verify --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'",
    "wait-4-docker": "node ./scripts/_wait4_all.js"
  },
  "overrides": {
    "form-data": "4.0.6",
    "on-headers": "1.1.0",
    "shins": {
      "ajv": "6.12.3",
      "ejs": "3.1.10",
      "sanitize-html": "2.17.5",
      "markdown-it": "14.3.3"
    },
    "widdershins": {
      "swagger2openapi": "7.0.8",
      "markdown-it": "14.3.3"
    },
    "yargs": {
      "yargs-parser": "21.1.1"
    },
    "jsonwebtoken": "9.0.3",
    "cross-spawn": "7.0.6",
    "path-to-regexp": "0.1.13",
    "validator": "13.15.22",
    "@hapi/wreck": "18.1.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "fast-xml-parser": "5.7.0",
    "qs": "6.16.0",
    "minimatch@3.0.5": "3.1.5",
    "immutable": "5.1.9",
    "axios": "1.20.0",
    "joi": "18.3.0",
    "@mojaloop/inter-scheme-proxy-cache-lib": {
      "ajv": "8.20.0"
    },
    "@mojaloop/ml-schema-transformer-lib": {
      "ajv": "8.20.0"
    },
    "@grpc/proto-loader": {
      "protobufjs": "8.8.0"
    },
    "@mojaloop/event-sdk": {
      "protobufjs": "8.8.0"
    },
    "@grpc/grpc-js": "1.14.6",
    "brace-expansion": "5.0.12",
    "tmp": "0.2.7",
    "istanbul-lib-processinfo": "3.0.1",
    "openapi-backend": "5.18.0",
    "uuid": "14.0.1",
    "convict": "6.2.5",
    "fast-uri": "3.1.8",
    "postcss": "8.5.26",
    "fast-xml-builder": "1.1.7",
    "js-yaml": "4.3.2",
    "swagmock": {
      "js-yaml": "3.15.2"
    },
    "browserslist": "4.28.7",
    "linkify-it": "5.0.2",
    "baseline-browser-mapping": "2.11.0",
    "@babel/core": "7.29.6",
    "js-yaml@3": "3.15.2",
    "handlebars": "4.7.10",
    "moment": "2.31.0",
    "undici@6": "6.29.1",
    "undici@7": "7.29.1",
    "yaml@1": "1.10.3",
    "yaml@2": "2.9.1",
    "argparse@1": "2.0.1",
    "serialize-error": "8.1.0",
    "follow-redirects": "1.16.1"
  },
  "dependencies": {
    "@hapi/good": "9.0.1",
    "@hapi/hapi": "21.4.11",
    "@hapi/inert": "7.1.3",
    "@hapi/vision": "7.0.3",
    "@mojaloop/central-services-error-handling": "13.2.1",
    "@mojaloop/central-services-health": "15.2.4",
    "@mojaloop/central-services-logger": "11.10.7",
    "@mojaloop/central-services-metrics": "12.8.9",
    "@mojaloop/central-services-shared": "18.39.4",
    "@mojaloop/central-services-stream": "11.12.0",
    "@mojaloop/event-sdk": "14.8.6",
    "@mojaloop/inter-scheme-proxy-cache-lib": "2.10.0",
    "@mojaloop/ml-number": "11.4.6",
