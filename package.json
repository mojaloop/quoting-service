  },
  "devDependencies": {
    "audit-ci": "7.1.0",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-jest": "29.17.0",
    "ioredis-mock": "8.13.1",
    "jest": "29.7.0",
    "jest-junit": "17.0.0",
    "npm-check-updates": "23.1.1",
    "nyc": "18.0.0",
    "pre-commit": "2.0.0",
    "replace": "1.2.2",
    "sinon": "22.1.0",
    "standard": "17.1.2",
    "standard-version": "9.5.0",
    "swagmock": "1.0.0"
  },
  "generator-swaggerize": {
    "version": "4.11.0"
  },
  "main": "src/server.js",
  "imports": {
    "#src/*": "./src/*.js",
    "#test/*": "./test/*.js"
  }
}
